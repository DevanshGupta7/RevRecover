# 94. Unsupported event test

```python
import pytest

from app.services.payment_events.parser import (
    parse_payment_event,
)


def test_unsupported_event_is_rejected():
    payload = {
        "account_id": "acc_test",
        "event": "payment.unknown",
        "created_at": 1700000000,
        "payload": {},
    }

    with pytest.raises(ValueError):
        parse_payment_event(
            payload=payload,
            provider_event_id="evt_test",
        )
```

